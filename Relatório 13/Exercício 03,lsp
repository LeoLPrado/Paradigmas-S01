(defstruct garota-magica nome escuridao bruxas)

(defun escuridao-total (grupo)
  (if (null grupo)
      0
      (+ (garota-magica-escuridao (car grupo))
         (escuridao-total (cdr grupo)))))

(defun total-de-bruxas (grupo)
  (reduce #'+ (mapcar #'garota-magica-bruxas grupo)))

(defun purifica (g quantidade)
  (make-garota-magica
   :nome (garota-magica-nome g)
   :escuridao (if (>= quantidade (garota-magica-escuridao g))
                  0
                  (- (garota-magica-escuridao g) quantidade))
   :bruxas (garota-magica-bruxas g)))

(defun main ()
  (let* ((grupo (list (make-garota-magica :nome "Madoka" :escuridao 20 :bruxas 3)
                      (make-garota-magica :nome "Sayaka" :escuridao 70 :bruxas 5)
                      (make-garota-magica :nome "Homura" :escuridao 45 :bruxas 12)))
         (kyoko (make-garota-magica :nome "Kyoko" :escuridao 30 :bruxas 8))
         (grupo-novo (cons kyoko grupo))
         (sayaka (second grupo))
         (sayaka-purificada (purifica sayaka 30)))
    (format t "Escuridao total do grupo: ~a~%" (escuridao-total grupo))
    (format t "Total de bruxas derrotadas: ~a~%" (total-de-bruxas grupo))
    (format t "Escuridao total do grupo novo (com Kyoko): ~a~%"
            (escuridao-total grupo-novo))
    (format t "Escuridao total do grupo original: ~a~%" (escuridao-total grupo))
    (format t "Sayaka original: ~a~%" (garota-magica-escuridao sayaka))
    (format t "Sayaka purificada: ~a~%" (garota-magica-escuridao sayaka-purificada))))

(main)